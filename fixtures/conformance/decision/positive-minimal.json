  "parents": ["rev:102abc"],
  "axiom_link": ["A1"],
  "intent": {
    "source": "issue:143",
    "text": "Search remains available when Redis is unavailable."
  },
  "commitment": "Fall back to origin.",
  "scope": [
    {"kind": "capability", "capability": "search-availability"},
    {"kind": "path", "path": "src/search/cache", "match": "tree"}
  ],
  "outcomes": [
    {
      "id": "availability",
      "statement": "Redis failure does not make search unavailable."
    }
  ],
  "obligations": [
    {
      "id": "bounded-fallback-amplification",
      "decision": "redis-origin-fallback",
      "outcome": "availability",
      "claim": "Simultaneous fallback traffic from all instances stays within origin capacity.",
      "subjects": [
        {"kind": "path", "path": "src/search/cache", "match": "tree"}
      ],
      "acceptance": {
        "all": [
          {"verifier": "search-fallback-load-test", "result": "pass"}
        ]
      },
      "phase": "pre-release"
    }
  ],
  "assumptions": [
    {
      "id": "origin-capacity",
      "state": "assumed",
      "statement": "Origin can absorb cache fallback traffic at peak.",
      "owner": "team:search",
