# Dockerfile.debian-slim
#
# Multi-stage build for math-coding release artifacts.
#
# Stage 1 (build): runs the existing flake.nix to produce a release-
# quality `mathc` binary. The flake is the same one the release
# pipeline uses; this Dockerfile does not introduce a new build path,
# only a new delivery path.
#
# Stage 2 (runtime): copies the resulting binary into a minimal
# debian:bookworm-slim image. The runtime image has no OCaml, no
# nix, no flake — just the binary on PATH. Image size: ~80 MB.
#
# Build context: repo root. Cv pre-existing tooling at flake.nix and
# bin/dune. Per `OCAML_BEST_PRACTICES` §11.26, the `container:`
# key in `.github/workflows/docker.yml` is at the JOB level only;
# this Dockerfile does not interact with that trap.
#
# Build invocation (locally, for smoke-testing only — production
# builds run in CI):
#
#   docker build -f Dockerfile.debian-slim \
#     --build-arg VERSION=$(cat VERSION) \
#     -t mathc:dev .
#
# Run:
#
#   docker run --rm -v $(pwd):/repo mathc:dev validate decisions/foo.yaml
#
# Authoritative attestation: tests/cli/docker-image-end-to-end.t
# asserts the CI-built image starts cleanly with `mathc version`.

# --- Stage 1: build -------------------------------------------------------
FROM nixos/nix:latest AS build

# The flake pin in flake.lock is authoritative. We copy the lockfile
# first so that the nix hash is stable across rebuilds (a fresh
# `nix flake update` in this stage would silently produce a different
# binary). Per `decisions/site-version-from-file-2026-10.yaml` the
# `VERSION` file is the single source of truth for the version string;
# we pass it into the runtime stage as a build-arg.
COPY flake.nix flake.lock /src/
COPY VERSION /src/VERSION

# `packages.default` declares `src = ./.`, so the build needs the
# repository tree, not just the flake files. Copying only the flake
# (as this stage used to) produced:
#     Error: Don't know how to build bin/mathc.exe
# on every build since the derivation gained `src = ./.`. The ordering
# above still matters — lockfile before sources keeps the pin stable
# across rebuilds — and .dockerignore keeps _build (283 MB) and .git
# out of the build context.
COPY lib/ /src/lib/
COPY bin/ /src/bin/
COPY spec/ /src/spec/
COPY schemas/ /src/schemas/
COPY tests/ /src/tests/
COPY render/ /src/render/
COPY fixtures/ /src/fixtures/
COPY scripts/ /src/scripts/
COPY adoption/ /src/adoption/
COPY assets/ /src/assets/
COPY axioms/ /src/axioms/
COPY decisions/ /src/decisions/
COPY attestations/ /src/attestations/
# Only tracked, committed files belong here. math-coding.install,
# math-coding.dune-package and META.math-coding are dune/opam build
# products (see .gitignore) and do not exist in a clean checkout, so
# copying them would fail the build with "not found".
COPY dune-project math-coding.opam .ocamlformat /src/

WORKDIR /src

# Build with the `default` app, which is `packages.<system>.default`.
# `--no-write-lock-file` keeps this stage hermetic; the lockfile in
# the repo is the source of truth, not a regenerated one.
RUN nix --extra-experimental-features 'nix-command flakes' \
        build --no-write-lock-file .#default \
    && cp result/bin/mathc /tmp/mathc \
    && mkdir -p /tmp/closure \
    && nix-store --query --requisites "$(readlink -f result)" \
         | while read -r p; do cp -a --parents "$p" /tmp/closure; done

# --- Stage 2: runtime -----------------------------------------------------
FROM debian:bookworm-slim

ARG VERSION=unknown

LABEL org.opencontainers.image.title="math-coding" \
      org.opencontainers.image.description="math-coding 3.0 kernel — risk-adaptive assurance protocol" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/11111000000/math-coding" \
      org.opencontainers.image.licenses="Apache-2.0"

RUN useradd --create-home --uid 10001 mathc
USER mathc

# Copy only the binary; the runtime image carries no OCaml, no flake,
# no source. `debian:bookworm-slim` is the smallest Debian base with
# glibc 2.36 — compatible with the existing `mathc-linux-x86_64` and
# `mathc-linux-aarch64` release assets (Ubuntu 22.04 / glibc 2.35+).
#
# The Nix runtime closure MUST come along, at its original store paths.
# `nix build .#default` links against the nix glibc and bakes an
# absolute ELF interpreter into the binary:
#   /nix/store/<hash>-glibc-2.42-84/lib/ld-linux-x86-64.so.2
# Without that path present, `mathc version` fails with
#   /bin/sh: 1: /usr/local/bin/mathc: not found
# which reads like a missing file but is a missing *loader*. The
# closure is 5 paths / ~42 MB (mathc, glibc-2.42, libgcc, libidn2,
# libunistring), so it is cheap to ship. This is the same non-portable
# binary OCAML_KERNEL_CONVENTIONS.md §11.22 warns about, resolved by
# carrying its runtime rather than by rebuilding against Debian glibc.
COPY --from=build /tmp/closure/nix /nix
COPY --from=build /tmp/mathc /usr/local/bin/mathc

# `mathc version` reads the VERSION file at RUNTIME, not at compile
# time. `read_cli_version` (bin/Mathc.ml) probes $DUNE_SOURCEROOT/VERSION
# then ./VERSION, ../VERSION and so on, and falls back to the literal
# string "math-coding" when none exists. Without this file the image
# reports "math-coding math-coding: bootstrap" and the CI smoke test —
# which asserts on "math-coding $VERSION" — fails even though the
# binary is perfectly healthy.
WORKDIR /app
COPY --from=build /src/VERSION /app/VERSION

# Verify the binary runs. If this fails the image is not publishable.
RUN /usr/local/bin/mathc version

ENTRYPOINT ["mathc"]
CMD ["version"]