#!/usr/bin/env bash
# .githooks/pre-commit
#
# Local fast-path enforcement of process-principles P1 and P2 at
# commit time. Mirrors tests/process_principles.ml with a lexical
# awk pass instead of a structural Yaml-aware walk. The OCaml test
# remains the rigorous check; this hook is the first-pass guard.
#
# P1 (decisions before kernel changes): a staged change to lib/,
# bin/Mathc.ml, spec/, or schemas/ must be accompanied by at least
# one staged decisions/*.yaml|.yml|.md file.
#
# P2 (decisions paired with fixtures): every obligation in a
# staged decisions/*.yaml|.md file must have at least one verifier
# line mapping to a present fixture path, a kernel-test reference,
# a cram .t path, or a recognised manual-style prefix.
#
# See:
#   decisions/process-principles.yaml                 (P1 + P2)
#   decisions/process-principles-close-branches.yaml  (this hook)
#
# Exit 0 on pass, 1 on fail. Opt-in via `scripts/dev init-hooks`
# (sets `git config core.hooksPath .githooks`).

set -u

staged=$(git diff --cached --name-only)
[ -z "$staged" ] && exit 0

# --- Classify staged paths -------------------------------------------------
kernel_change=0
decision_change=0
while IFS= read -r p; do
  case "$p" in
    lib/*|bin/Mathc.ml|spec/*|schemas/*) kernel_change=1 ;;
    decisions/*.yaml|decisions/*.yml|decisions/*.md) decision_change=1 ;;
  esac
done <<<"$staged"

# --- P1 --------------------------------------------------------------------
if [ "$kernel_change" = "1" ] && [ "$decision_change" = "0" ]; then
  echo "pre-commit: P1 violated — kernel/spec change without a decision file. Add a \`decisions/<id>.yaml\` change."
  exit 1
fi

# --- P2 --------------------------------------------------------------------
[ "$decision_change" = "1" ] || exit 0

p2_fail=0
while IFS= read -r df; do
  case "$df" in
    decisions/*.yaml|decisions/*.yml|decisions/*.md) ;;
    *) continue ;;
  esac
  [ -f "$df" ] || continue
  # Meta files carry a different schema (per OCaml test's
  # excluded_decision_files); the rigorous check skips them, so
  # do we.
  base=$(basename "$df")
  case "$base" in
    decision.yaml|obligations.yaml|rationale.md) continue ;;
  esac

  # Editorial exemption (per AGENTS.md §Before work, "provably
  # editorial change" contract, line 105). When a staged
  # decision file declares `change_kind: editorial` at the top
  # level (outside the YAML front-matter `---` block), P2 is
  # satisfied for the whole file: obligations may have no
  # verifier, or there may be no obligations at all. The
  # rationale is recorded in
  # `decisions/process-principles-close-branches.yaml`
  # obligation `editorial-exemption-impl`.
  if grep -qE '^change_kind:[[:space:]]+editorial([[:space:]]|$)' "$df"; then
    echo "pre-commit: $df declares change_kind: editorial — P2 exempted"
    continue
  fi

  orphans=$(awk '
    function classify(v) {
      if (v == "") return 0
      gsub(/^["\x27]|["\x27]$/, "", v)
      if (v == "") return 0
      if (v ~ /^(mathc-|manual:|manual-|text-scan-|cram-fixture-|script-runs-|conformance-fixtures-|compiler-warning-|sha256-|flake-pin-|reference-class-|this-decision-file-|practice-review|gate-shape-fixture|dune |mathc |bash |sh |git |gh |grep |awk |sed |python |perl |nix |cargo|rg |ls )/) return 1
      if (v ~ /^tests\//) return 1
      if (v ~ /^fixtures\/conformance\//) return 1
      if (v ~ /^scripts\//) return 1
      if (v ~ /^dist\//) return 1
      if (v ~ /\.(sh|t|ml|exe|json|yaml|md|html)$/) return 1
      if (v !~ /[[:space:]]/) {
        if (v ~ /^[a-z][-a-z0-9_]+$/) return 1
      }
      if (v ~ /-review$/) return 1
      if (v ~ /[[:alpha:]]/) return 1
      return 0
    }
    function flush() {
      if (buf ~ /evidence:[[:space:]]*manual-acceptance/) return
      n = split(buf, lines, "\n")
      for (i = 1; i <= n; i++) {
        l = lines[i]
        if (l ~ /verifier:/) {
          v = l
          sub(/.*verifier:[[:space:]]*/, "", v)
          # Accumulate YAML 1.1 plain-scalar continuation lines
          # (indented text without `key:` siblings).
          j = i + 1
          while (j <= n \
                 && lines[j] ~ /^[[:space:]]+[^[:space:]]/ \
                 && lines[j] !~ /:[[:space:]]/) {
            t = lines[j]
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", t)
            v = v " " t
            j++
          }
          gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
          if (v != "" && classify(v)) return
          i = j - 1
        }
      }
      print id
    }
    in_obligation_section == 0 {
      if ($0 ~ /^obligations:/) {
        in_obligation_section = 1
      }
      next
    }
    {
      if ($0 ~ /^(outcomes|assumptions|reversal|risk|relations|evidence):/) {
        if (in_block) flush()
        in_block = 0
        in_obligation_section = 0
        next
      }
      if ($0 ~ /^[[:space:]]*-[[:space:]]*id:[[:space:]]*/) {
        if (in_block) flush()
        id = $0
        sub(/^[[:space:]]*-[[:space:]]*id:[[:space:]]*/, "", id)
        gsub(/[[:space:]].*$/, "", id)
        in_block = 1
        buf = ""
        next
      }
      if (in_block) {
        buf = buf "\n" $0
      }
    }
    END {
      if (in_block) flush()
    }
  ' "$df")
  if [ -n "$orphans" ]; then
    while IFS= read -r o; do
      [ -z "$o" ] && continue
      echo "$df"
      echo "pre-commit: P2 violated — obligation $o has no verifier."
    done <<<"$orphans"
    p2_fail=1
  fi
done <<<"$staged"

[ "$p2_fail" = "1" ] && exit 1
exit 0