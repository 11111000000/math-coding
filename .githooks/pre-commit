#!/usr/bin/env bash
# .githooks/pre-commit
#
# Local fast-path enforcement of process-principles P1 and P2 at
# commit time. Mirrors tests/process_principles.ml with a lexical
# awk pass instead of a structural Yaml-aware walk. The OCaml test
# remains the rigorous check; this hook is the first-pass guard.
#
# P1 (decisions before kernel changes): a staged change to lib/,
# bin/Mathc.ml, spec/, or schemas/ must be accompanied by at least
# one staged decisions/*.yaml|.yml|.md file.
#
# P2 (decisions paired with fixtures): every obligation in a
# staged decisions/*.yaml|.md file must have at least one verifier
# line mapping to a present fixture path, a kernel-test reference,
# a cram .t path, or a recognised manual-style prefix.
#
# See:
#   decisions/process-principles.yaml                 (P1 + P2)
#   decisions/process-principles-close-branches.yaml  (this hook)
#
# Exit 0 on pass, 1 on fail. Opt-in via `scripts/dev init-hooks`
# (sets `git config core.hooksPath .githooks`).

set -u

staged=$(git diff --cached --name-only)
[ -z "$staged" ] && exit 0

# --- Classify staged paths -------------------------------------------------
kernel_change=0
decision_change=0
while IFS= read -r p; do
  case "$p" in
    lib/*|bin/Mathc.ml|spec/*|schemas/*) kernel_change=1 ;;
    decisions/*.yaml|decisions/*.yml|decisions/*.md) decision_change=1 ;;
  esac
done <<<"$staged"

# --- P1 --------------------------------------------------------------------
if [ "$kernel_change" = "1" ] && [ "$decision_change" = "0" ]; then
  echo "pre-commit: P1 violated — kernel/spec change without a decision file. Add a \`decisions/<id>.yaml\` change."
  exit 1
fi

# --- P8 --------------------------------------------------------------------
# Edit-loop detection. If a .ml/.mli file staged in this commit was
# modified 3+ times in the last 5 commits (across any branch), the
# agent is likely in an edit-loop. Stop, write a probe executable,
# identify whether it's a SYNTAX fix (1-3 lines) or a STRUCTURE fix
# (refactor a deeply nested match to a helper). See
# AGENTS.md §Edit-loop prevention and trap §11.24.
staged_ml=$(git diff --cached --name-only | grep -E '\.(ml|mli)$' || true)
if [ -n "$staged_ml" ]; then
  HOT=$(git log --name-only --pretty=format: -n 5 \
    | grep -E '\.(ml|mli)$' | sort | uniq -c | sort -rn \
    | awk '$1 >= 3 {print $0}')
  if [ -n "$HOT" ]; then
    echo "pre-commit: P8 violated — edit-loop pattern detected."
    echo "Files modified 3+ times in last 5 commits:"
    echo "$HOT"
    echo "Currently staged .ml/.mli files:"
    echo "$staged_ml"
    echo "Switch to probe-driven debugging (AGENTS.md §Edit-loop prevention)."
    exit 1
  fi
fi

# --- T1.2 -------------------------------------------------------------------
# Tool-name sanity. The binaries `merlin` and `ocaml-lsp-server` do NOT
# exist in nix develop .#test (see OCAML_BEST_PRACTICES.md §11.34).
# Correct names: `ocamlmerlin`, `ocamllsp`.
#
# Allowlist:
#   - `.merlin` (the config file — its filename is a literal)
#   - `OCAML_BEST_PRACTICES.md` §11.34 (documents wrong names as
#     examples)
#   - `decisions/merlin-lsp-2026-10.yaml` (decision about the tool
#     stack; the wrong names appear in body references)
tool_block_hits=$(git diff --cached \
  | grep -E '^\+' \
  | grep -v '^\+\+\+' \
  | grep -E '\b(merlin|ocaml-lsp-server)\b' \
  | grep -vE '\.merlin|OCAML_BEST_PRACTICES\.md|decisions/merlin-lsp-2026-10\.yaml' \
  || true)
if [ -n "$tool_block_hits" ]; then
  echo "pre-commit: T1.2 violated — stage references 'merlin' or 'ocaml-lsp-server'."
  echo "These binaries do NOT exist; correct names are:"
  echo "  ocamlmerlin       (package: merlin)"
  echo "  ocamllsp          (package: ocaml-lsp)"
  echo "Offending added lines:"
  echo "$tool_block_hits"
  exit 1
fi

# --- T1.4 -------------------------------------------------------------------
# Branch naming convention warning. Topic branches SHOULD match
# `[a-z0-9./-]+-[0-9]{4}-[0-9]{2}$` (kebab + month). This is a soft
# warning, not a hard block, so as not to break legacy branches
# (counters-fix, validate-fix, etc.). New branches SHOULD follow
# the convention. See AGENTS.md §Worktree-first.
branch=$(git rev-parse --abbrev-ref HEAD)
case "$branch" in
  main|master|release/*|hotfix/*|work/*|wip/*|fix/*|feat/*|chore/*)
    : # accepted exception
    ;;
  *)
    if ! echo "$branch" | grep -qE '^[a-z0-9./-]+-[0-9]{4}-[0-9]{2}$'; then
      echo "pre-commit: T1.4 soft warning — branch '$branch' does not follow YYYY-MM convention." >&2
      echo "Recommended: rename to '${branch}-2026-10' or similar (see AGENTS.md §Worktree-first)." >&2
      # soft warning: do NOT exit 1
    fi
    ;;
esac

# --- P2 --------------------------------------------------------------------
# Now P8/T1.2/T1.4 (above) have run unconditionally. P2 only runs
# when a decision file is staged; otherwise exit 0.
[ "$decision_change" = "1" ] || exit 0

p2_fail=0
while IFS= read -r df; do
  case "$df" in
    decisions/*.yaml|decisions/*.yml|decisions/*.md) ;;
    *) continue ;;
  esac
  [ -f "$df" ] || continue
  # Meta files carry a different schema (per OCaml test's
  # excluded_decision_files); the rigorous check skips them, so
  # do we.
  base=$(basename "$df")
  case "$base" in
    decision.yaml|obligations.yaml|rationale.md) continue ;;
  esac

  # Editorial exemption (per AGENTS.md §Before work, "provably
  # editorial change" contract, line 105). When a staged
  # decision file declares `change_kind: editorial` at the top
  # level (outside the YAML front-matter `---` block), P2 is
  # satisfied for the whole file: obligations may have no
  # verifier, or there may be no obligations at all. The
  # rationale is recorded in
  # `decisions/process-principles-close-branches.yaml`
  # obligation `editorial-exemption-impl`.
  if grep -qE '^change_kind:[[:space:]]+editorial([[:space:]]|$)' "$df"; then
    echo "pre-commit: $df declares change_kind: editorial — P2 exempted"
    continue
  fi

  orphans=$(awk '
    function classify(v) {
      if (v == "") return 0
      gsub(/^["\x27]|["\x27]$/, "", v)
      if (v == "") return 0
      if (v ~ /^(mathc-|manual:|manual-|text-scan-|cram-fixture-|script-runs-|conformance-fixtures-|compiler-warning-|sha256-|flake-pin-|reference-class-|this-decision-file-|practice-review|gate-shape-fixture|dune |mathc |bash |sh |git |gh |grep |awk |sed |python |perl |nix |cargo|rg |ls )/) return 1
      if (v ~ /^tests\//) return 1
      if (v ~ /^fixtures\/conformance\//) return 1
      if (v ~ /^scripts\//) return 1
      if (v ~ /^dist\//) return 1
      if (v ~ /\.(sh|t|ml|exe|json|yaml|md|html)$/) return 1
      if (v !~ /[[:space:]]/) {
        if (v ~ /^[a-z][-a-z0-9_]+$/) return 1
      }
      if (v ~ /-review$/) return 1
      if (v ~ /[[:alpha:]]/) return 1
      return 0
    }
    function flush() {
      if (buf ~ /evidence:[[:space:]]*manual-acceptance/) return
      n = split(buf, lines, "\n")
      for (i = 1; i <= n; i++) {
        l = lines[i]
        if (l ~ /verifier:/) {
          v = l
          sub(/.*verifier:[[:space:]]*/, "", v)
          # Accumulate YAML 1.1 plain-scalar continuation lines
          # (indented text without `key:` siblings).
          j = i + 1
          while (j <= n \
                 && lines[j] ~ /^[[:space:]]+[^[:space:]]/ \
                 && lines[j] !~ /:[[:space:]]/) {
            t = lines[j]
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", t)
            v = v " " t
            j++
          }
          gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
          if (v != "" && classify(v)) return
          i = j - 1
        }
      }
      print id
    }
    in_obligation_section == 0 {
      if ($0 ~ /^obligations:/) {
        in_obligation_section = 1
      }
      next
    }
    {
      if ($0 ~ /^(outcomes|assumptions|reversal|risk|relations|evidence):/) {
        if (in_block) flush()
        in_block = 0
        in_obligation_section = 0
        next
      }
      if ($0 ~ /^[[:space:]]*-[[:space:]]*id:[[:space:]]*/) {
        if (in_block) flush()
        id = $0
        sub(/^[[:space:]]*-[[:space:]]*id:[[:space:]]*/, "", id)
        gsub(/[[:space:]].*$/, "", id)
        in_block = 1
        buf = ""
        next
      }
      if (in_block) {
        buf = buf "\n" $0
      }
    }
    END {
      if (in_block) flush()
    }
  ' "$df")
  if [ -n "$orphans" ]; then
    while IFS= read -r o; do
      [ -z "$o" ] && continue
      echo "$df"
      echo "pre-commit: P2 violated — obligation $o has no verifier."
    done <<<"$orphans"
    p2_fail=1
  fi
done <<<"$staged"

[ "$p2_fail" = "1" ] && exit 1
exit 0
