_build/
*.install
*.opam
.math/cache/
dist/
result
result/

# Worktree directories created by `git worktree add`. Each
# per-machine, per-branch, with its own .git pointer; never
# committed.
.worktrees/

# time-honesty-storage obligation storage-paths-declared:
# per-worktree runtime data; never committed, never uploaded.
.local
decisions/execution-logs.jsonl
scripts/__pycache__/

# Playwright MCP browser session artifacts (local profile,
# screenshots, traces). Regenerated on every browser run.
.playwright-mcp/

# The historical /doc/ directory was merged into /docs/ as
# of commit 65d3015's follow-up. Any stray file dropped into
# /doc/ by a future tool is a mistake; the canonical location
# for audits, historical notes, and upstream-bug records is
# /docs/.
/doc/

# `mathc re-evaluate-decisions A0` emits one JSON per
# (decision, obligation) it walks under the A0 axiom lens.
# These are re-evaluation scratch output, regenerated on
# every test run, and no committed attestation matches
# the `t1-2-A0-` prefix (the canonical re-evaluation
# attestations are `t1-2-A3-…` for the A3-linked decisions).
attestations/t1-2-A0-*.json

# `tests/cli/adopt.t` and the `mathc import-adr --write` /
# `mathc new-decision` cram flows scaffold two throwaway
# decisions named `1-foo` and `1-use-postgresql` as part
# of their fixtures. They are test output, not real
# commitments, and should never be committed.
decisions/1-foo.yaml
decisions/1-use-postgresql.yaml

# `scripts/render-svgs.sh` emits PNG snapshots of every
# assets/*.svg here. The snapshots are visual-verification
# scratch — regenerated on every render — and should never
# be committed.
assets/_renders/
tools/winget/scripts/__pycache__/
