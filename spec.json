  "claims": [
    {
      "id": "core-laws",
      "text": "pure verdict laws and freshness",
      "scope": [ "lib/", "test/laws.ml" ],
      "source": null,
      "kind": "acceptance",
      "phase": "pre-merge",
      "owner": "owner",
      "review_on": [],
      "requirements": [
        {
          "kind": "verifier",
          "spec": "dune runtest --root . --force test/laws.exe"
        }
      ],
      "falsifier": "a broken verdict or freshness rule passes",
      "register": "fact",
      "control": "sed -i 's/| Red, _ | _, Red -> Red/| Red, _ | _, Red -> Green/' lib/verdict.ml",
      "waiver": null
    },
    {
      "id": "strict-codecs",
      "text": "strict versioned JSON codecs",
      "scope": [ "format/", "test/spec_format.ml" ],
      "source": null,
      "kind": "acceptance",
      "phase": "pre-merge",
      "owner": "owner",
      "review_on": [],
      "requirements": [
        {
          "kind": "verifier",
          "spec": "dune runtest --root . --force test/spec_format.exe"
        }
      ],
      "falsifier": "an unknown, duplicate, or legacy-invalid field is accepted",
      "register": "fact",
      "control": "sed -i 's/| key :: _, _ -> Error (what ^ \": unknown field \" ^ key)/| key :: _, _ -> Ok pairs/' format/json_helpers.ml",
      "waiver": null
    },
    {
      "id": "cli-evidence",
