      "scope": [ "flake.nix", "test/package_smoke.sh" ],
      "source": null,
      "kind": "acceptance",
      "phase": "pre-merge",
      "owner": "owner",
      "review_on": [],
      "requirements": [
        { "kind": "verifier", "spec": "sh test/package_smoke.sh portable" }
      ],
      "falsifier": "a portable binary needs Nix store paths or cannot run",
      "register": "fact",
      "control": "sed -i 's/dune build --root . bin\\/mathc.exe bin\\/stand.exe/dune build --root . missing-target/' flake.nix",
