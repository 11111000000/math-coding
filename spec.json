      "source": null,
      "kind": "acceptance",
      "phase": "pre-merge",
      "owner": "owner",
      "review_on": [],
      "requirements": [
        {
          "kind": "verifier",
          "spec": "dune runtest --root . --force test/repository_lints.exe test/repository_control.exe"
        }
      ],
      "falsifier": "a core or interface exceeds its bound or loses required files",
