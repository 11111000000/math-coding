{
  "schema_version": 5,
  "goal": {
    "text": "v5 keeps evidence linked, fresh, and independent",
    "scope": [
      "lib/", "format/", "adapter/", "bin/", "test/", "spec.json",
      "flake.nix", "GOAL.md", "PHILOSOPHY.md", "AXIOMS.md", "README.md",
      "AGENTS.md", "docs/", "dune-project"
    ],
    "by": "owner",
    "at": 1794331411,
    "reason": null
  },
  "claims": [
    {
      "id": "core-laws",
      "text": "pure verdict laws and freshness",
      "scope": [ "lib/", "test/laws.ml" ],
      "source": null,
      "kind": "acceptance",
      "phase": "pre-merge",
      "owner": "owner",
      "review_on": [],
      "requirements": [
        {
          "kind": "verifier",
          "spec": "dune runtest --root . --force test/laws.exe"
        }
      ],
      "falsifier": "a broken verdict or freshness rule passes",
      "register": "fact",
      "control": "sed -i 's/| Red, _ | _, Red -> Red/| Red, _ | _, Red -> Green/' lib/verdict.ml",
      "waiver": null
    },
    {
      "id": "strict-codecs",
      "text": "strict versioned JSON codecs",
      "scope": [ "format/", "test/spec_format.ml" ],
      "source": null,
      "kind": "acceptance",
      "phase": "pre-merge",
      "owner": "owner",
      "review_on": [],
      "requirements": [
        {
          "kind": "verifier",
          "spec": "dune runtest --root . --force test/spec_format.exe"
        }
      ],
      "falsifier": "an unknown, duplicate, or legacy-invalid field is accepted",
      "register": "fact",
      "control": "sed -i 's/| key :: _, _ -> Error (what ^ \": unknown field \" ^ key)/| key :: _, _ -> Ok pairs/' format/json_helpers.ml",
      "waiver": null
    },
    {
      "id": "cli-evidence",
      "text": "the CLI produces fresh independent evidence",
      "scope": [ "bin/", "adapter/", "test/cli.ml" ],
      "source": null,
      "kind": "acceptance",
      "phase": "pre-merge",
      "owner": "owner",
      "review_on": [],
      "requirements": [
        {
          "kind": "verifier",
          "spec": "dune runtest --root . --force test/cli.exe"
        }
      ],
      "falsifier": "a claim holds without current independent evidence",
      "register": "fact",
      "control": "sed -i 's/check.code = 1/check.code = 0/' bin/commands.ml",
      "waiver": null
    },
    {
      "id": "adr-junit",
      "text": "ADR and JUnit are imported read-only with provenance",
      "scope": [ "adapter/adr.ml", "adapter/junit.ml", "test/adr_junit.ml" ],
      "source": null,
      "kind": "acceptance",
      "phase": "pre-merge",
      "owner": "owner",
      "review_on": [],
      "requirements": [
        {
          "kind": "verifier",
          "spec": "dune runtest --root . --force test/adr_junit.exe"
        }
      ],
      "falsifier": "an import writes the source or loses nested evidence",
      "register": "fact",
      "control": "sed -i 's/Omd.of_string (Io.read_file full_path)/Omd.of_string \"\"/' adapter/adr.ml",
      "waiver": null
    },
    {
      "id": "mcp-contract",
      "text": "MCP returns typed JSON-RPC results and actionable errors",
      "scope": [ "bin/mcp.ml", "test/mcp.ml" ],
      "source": null,
      "kind": "acceptance",
      "phase": "pre-merge",
      "owner": "owner",
      "review_on": [],
      "requirements": [
        {
          "kind": "verifier",
          "spec": "dune runtest --root . --force test/mcp.exe"
        }
      ],
      "falsifier": "a result is prose instead of structured JSON or an invalid protocol is accepted",
      "register": "fact",
      "control": "sed -i 's/let protocol_version = \"2026-07-28\"/let protocol_version = \"broken\"/' bin/mcp.ml",
      "waiver": null
    },
    {
      "id": "protected-stand",
      "text": "protected transitions and the measurement stand work on installed tools",
      "scope": [
        "adapter/policy.ml", "bin/stand.ml", "test/policy.ml",
        "test/stand.ml"
      ],
      "source": null,
      "kind": "acceptance",
      "phase": "pre-merge",
      "owner": "owner",
      "review_on": [],
      "requirements": [
        {
          "kind": "verifier",
          "spec": "dune runtest --root . --force test/policy.exe test/stand.exe"
        }
      ],
      "falsifier": "an unauthorized transition passes or the stand cannot find mathc",
      "register": "fact",
      "control": "sed -i 's/match Sys.getenv_opt \"MATHC\" with/match Some \"\\/definitely-missing-mathc\" with/' bin/stand.ml",
      "waiver": null
    },
    {
      "id": "flake-binary",
      "text": "installed mathc and stand work together",
      "scope": [ "flake.nix", "test/package_smoke.sh" ],
      "source": null,
      "kind": "acceptance",
      "phase": "pre-merge",
      "owner": "owner",
      "review_on": [],
      "requirements": [
        { "kind": "verifier", "spec": "sh test/package_smoke.sh" }
      ],
      "falsifier": "an installed tool cannot run or stand cannot find mathc",
      "register": "fact",
      "control": "sed -i 's/dune build --root . ${target}/dune build --root . missing-target/' flake.nix",
      "waiver": null
