{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-coding.org/schema/3.0-alpha/decision.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "kind", "id", "intent", "commitment",
    "scope", "outcomes", "obligations"
  ],
  "properties": {
    "schema": {"const": "math-coding/3.0-alpha/decision"},
    "kind": {"const": "decision"},
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "revision": {"type": "string", "minLength": 1},
    "parents": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "intent": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "text"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "commitment": {"type": "string", "minLength": 1},
    "scope": {"$ref": "common.json#/definitions/scope"},
    "outcomes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "statement": {"type": "string", "minLength": 1}
        }
      }
    },
    "assumptions": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "state", "statement", "owner"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
          "state": {"enum": ["assumed", "unknown"]},
          "statement": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "consequence_if_false": {"type": "string"},
          "review_on": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["signal"],
              "properties": {
                "signal": {"type": "string"},
                "date": {"$ref": "common.json#/definitions/timestamp"}
              }
            }
          }
        }
      }
    },
    "obligations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "obligation.json"}
    },
    "reversal": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["signal", "action"],
        "properties": {
          "signal": {"type": "string"},
          "condition": {"type": "string"},
          "action": {"enum": ["revert", "halt", "review", "rework"]}
        }
      }
    },
    "risk": {
      "type": "object", "additionalProperties": false,
      "required": ["declared_triggers", "owner"],
      "properties": {
        "declared_triggers": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string"}
        },
        "owner": {"type": "string"}
      }
    },
    "relations": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "supersedes": {"type": "array", "items": {"type": "string"}},
        "addresses": {"type": "array", "items": {"type": "string"}},
        "depends_on": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
