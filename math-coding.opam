opam-version: "2.0"
synopsis: "Curry-Howard convention for AI coding agents, v1.0"
description: """
math-coding v1.0 — packets for decision documentation.
A packet records a proposition, antithesis, synthesis, and
optional executable spec. The OCaml runtime verifies packet
structure, lifecycle, witness history, and epistemic markers.
"""
maintainer: "math-coding contributors"
authors: "math-coding contributors"
license: "Living Beings License"
homepage: "https://github.com/11111000000/math-coding"
bug-reports: "https://github.com/11111000000/math-coding/issues"
depends: [
  "ocaml" {>= "5.0.0"}
  "dune" {>= "3.0"}
  "ocaml-yaml" {>= "3.0"}
  "yojson" {>= "2.0"}
  "alcotest" {with-test}
  "qcheck" {with-test}
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-j" jobs]
  ["dune" "runtest" "-j" jobs] {with-test}
  ["dune" "build" "--profile" "release"]
]
dev-repo: "git+https://github.com/11111000000/math-coding.git"
