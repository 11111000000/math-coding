#!/usr/bin/env bash
# scripts/dev-fast — fast-path wrapper for math-coding's read-only dev loop.
#
# Why this script exists
# ----------------------
# The canonical entry points (`scripts/dev build`, `scripts/dev verify`,
# `scripts/dev ready`) wrap every command in
# `nix develop .#test --command bash -c "..."`, which costs ~1 second of
# shell-entry overhead per invocation. For read-only operations like
# `mathc validate`, `mathc self-check`, and `mathc packages`, this
# overhead is 50x-100x the actual work (~14 ms).
#
# `scripts/dev-fast` reuses the same shell-detection heuristics but routes
# read-only operations to the direct binary path:
#
#   1. `~/.local/bin/mathc` (the installed artifact; shared across
#      worktrees)
#   2. `_build/default/bin/mathc.exe` (this worktree's local build)
#   3. fallback: `scripts/dev <cmd>` (the slow path with nix-shell)
#
# Usage:
#   scripts/dev-fast validate FILE              1-file parse-ok
#   scripts/dev-fast validate-all               bulk validate decisions/*.yaml
#   scripts/dev-fast self-check                 JSON self-check verdict
#   scripts/dev-fast status                     one-line summary
#   scripts/dev-fast precommit [PATH...]        P1/P2 hook + validate
#   scripts/dev-fast doctor                     mathc doctor --json
#   scripts/dev-fast <anything-else>            fall through to scripts/dev
#
# Why this is fast path (AGENTS.md §"Fast path")
# ----------------------------------------------
# 1. net change ≤ 50 lines (the wrapper itself + docs);
# 2. no change to lib/, bin/Mathc.ml, schemas/, decisions/*, or policies;
# 3. no new obligation / attestation / policy term;
# 4. described in 2 sentences.
#
# Boundary
# --------
# This wrapper does NOT shell into nix for any operation it owns. If
# `~/.local/bin/mathc` exists, every command is one shell exec. If not,
# fall through to `scripts/dev` (the slow path). See end of file for
# the resolution order.
#
# Reference timings measured on 2026-10-19 against HEAD 66f9eb0:
#
#   operation             nix-shell       direct
#   validate FILE         ~1.0 s          ~0.014 s   (70x)
#   self-check            ~1.3 s          ~0.190 s   (~7x)
#   new-decision          ~1.0 s          ~0.006 s   (170x)
#   status (new)          ~1.0 s          ~0.020 s   (50x)

set -eu

cd "$(dirname "$0")/.."

# --- resolve the mathc binary (fast path first) --------------------------
resolve_mathc() {
  if [ -x "${HOME}/.local/bin/mathc" ]; then
    echo "${HOME}/.local/bin/mathc"
    return 0
  fi
  if [ -x "./_build/default/bin/mathc.exe" ]; then
    echo "./_build/default/bin/mathc.exe"
    return 0
  fi
  return 1
}

mathc_bin=""
if mathc_bin="$(resolve_mathc)"; then :; else
  echo "scripts/dev-fast: no mathc binary found. Falling through to scripts/dev." >&2
  exec scripts/dev "$@"
fi

usage() {
  sed -n '2,30p' "$0"
  exit 1
}

cmd="${1:-}"
shift || true

case "$cmd" in

  # ---------- fast-path: per-file validate ------------------------------
  validate)
    [ $# -ge 1 ] || usage
    for f in "$@"; do
      "$mathc_bin" validate "$f"
    done
    ;;

  # ---------- fast-path: bulk validate ---------------------------------
  validate-all)
    # Walks decisions/*.yaml; skips the three non-decision files the
    # kernel treats specially (decision.yaml, obligations.yaml, rationale.md).
    set +e
    rc=0
    for f in decisions/*.yaml; do
      case "$(basename "$f")" in
        decision.yaml|obligations.yaml|rationale.md) continue ;;
      esac
      "$mathc_bin" validate "$f" >/dev/null 2>&1
      e=$?
      case "$e" in
        0) ;;
        *) echo "validate-all: REJECT $f (exit $e)" >&2; rc=1 ;;
      esac
    done
    exit "$rc"
    ;;

  # ---------- fast-path: full self-check --------------------------------
  self-check)
    "$mathc_bin" self-check
    ;;

  # ---------- fast-path: one-line status --------------------------------
  status)
    # Single-line summary that an agent can paste into a report.
    # Combines version, decisions, attestations, attestation store
    # path, and the top-level self-check verdict.
    version=$("$mathc_bin" version 2>/dev/null | head -1)
    n_dec=$(ls decisions/*.yaml 2>/dev/null | wc -l)
    n_att=$(ls attestations/*.json 2>/dev/null | wc -l)
    verdict=$("$mathc_bin" self-check 2>/dev/null \
              | sed -n 's/.*"verdict":"\([^"]*\)".*/\1/p' \
              | tail -1)
    att_dir=${MATH_CODING_ATTESTATIONS_DIR:-./attestations}
    dec_dir=${MATH_CODING_DECISIONS_DIR:-./decisions}
    printf 'mathc %s | decisions=%d attestations=%d | verdict=%s | %s/ %s/\n' \
      "$version" "$n_dec" "$n_att" "$verdict" "$dec_dir" "$att_dir"
    ;;

  # ---------- fast-path: mathc doctor -----------------------------------
  doctor)
    "$mathc_bin" doctor "$@"
    ;;

  # ---------- fast-path: local precommit hook ---------------------------
  precommit)
    # Same lexical check as .githooks/pre-commit for the staged set, then
    # run mathc validate on the staged decision files. Exits 0 on pass.
    if [ -z "${STAGED:-}" ]; then
      STAGED="$(git diff --cached --name-only 2>/dev/null || true)"
    fi
    staged_ml=$(printf '%s\n' "$STAGED" | grep -E '\.(ml|mli)$' || true)
    staged_dec=$(printf '%s\n' "$STAGED" | grep -E '^decisions/.*\.(yaml|md)$' || true)
    # P1: kernel change without decision file → reject.
    if [ -n "$staged_ml" ]; then
      case "$staged_ml" in lib/*|bin/Mathc.ml|spec/*|schemas/*)
        if [ -z "$staged_dec" ]; then
          echo "precommit: P1 violated — kernel/spec change without a decision file." >&2
          exit 1
        fi
        ;;
      esac
    fi
    # Validate every staged decision file.
    if [ -n "$staged_dec" ]; then
      for f in $staged_dec; do
        [ -f "$f" ] || continue
        "$mathc_bin" validate "$f" >/dev/null
      done
    fi
    ;;

  # ---------- slow-path: anything else → scripts/dev -------------------
  ""|-h|--help|help) usage ;;
  *)
    echo "scripts/dev-fast: '$cmd' is not fast-path; falling through to scripts/dev" >&2
    exec scripts/dev "$cmd" "$@"
    ;;

esac
