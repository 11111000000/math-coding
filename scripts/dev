#!/usr/bin/env bash
# math-coding 3.3.1 — repeatable development commands.
#
# Each subcommand prints what it is doing. None of them are silent.
# Use these instead of "rm -rf _build" superstition.
#
# Usage:
#   scripts/dev build                — compile kernel + CLI
#   scripts/dev test                 — run conformance suite
#   scripts/dev rebuild              — full rebuild (when build is wedged)
#   scripts/dev lint                 — strict warnings-as-errors build
#   scripts/dev verify               — full check before commit: build +
#                                     dune test + scripts/check.sh + fmt
#   scripts/dev check                — nix flake check
#   scripts/dev close-branches       — list branches merged into main
#                                     [--yes] also delete + push to origin
#   scripts/dev init-hooks           — one-time: git config core.hooksPath
#                                     .githooks
#   scripts/dev precommit            — activate .githooks/ (idempotent)
#                                     then exec git commit with the
#                                     same args
#   scripts/dev ready                — Definition-of-Done aggregator:
#                                     8 stages; halts on first failure
#   scripts/dev lock-update          — refresh flake.lock
#   scripts/dev shell                — drop into nix develop .#test
#   scripts/dev run FILE             — build + run mathc.exe FILE
#   scripts/dev doctor               — opt-in health check (no compile):
#                                     which/grep counts only. Exits 0
#                                     if every check passes.
#   scripts/dev edit-loop-detect      — opt-in: scan last 5 commits for
#                                     files modified 3+ times; exit 1
#                                     if edit-loop pattern detected.
#   scripts/dev test-fast             — fast-path test runner: invokes
#                                     each test binary directly. Bypasses
#                                     `dune test` to avoid the dune
#                                     3.23.1 RPC hang (see
#                                     OCAML_BEST_PRACTICES §11.34) and
#                                     skip the `dune-test-with-timeout`
#                                     budget. Per-binary runs finish in
#                                     <1s when source unchanged.
#   scripts/dev probe [--file F] TEXT — build & run a one-shot probe that
#                                     calls Render.md_parse on TEXT (or
#                                     the contents of F) and prints the
#                                     produced HTML. Designed for parser
#                                     bug fixes: skip the 5+ min full
#                                     test suite, see the output in
#                                     <1s. The probe executable is
#                                     _build/default/bin/md_probe.exe.

set -eu
cd "$(dirname "$0")/.."

usage() {
  sed -n '2,21p' "$0"
  exit 1
}

cmd="${1:-}"
shift || true

# Run a command inside the `test` dev shell.
#
# Routed through scripts/dev-env.sh, which serves a cached
# `nix print-dev-env` instead of re-entering `nix develop` on every
# invocation. This matters because `nix develop` takes the Nix store
# lock, which nix-gc holds for ~40 s every night — a silent stall with
# rc=0 and no output. See OCAML_BEST_PRACTICES §11.42.
# dev-env.sh falls back to `nix develop` on its own if the cache
# cannot be built, so this is a speed/robustness change, never a
# behavioural one.
run_in_shell() {
  # shellcheck disable=SC1091
  . "$(dirname "$0")/dev-env.sh"
  mc_run_in_shell "$1"
}

# Kill stale dune processes that may hold _build/.lock from a previous
# interrupted run, then drop the lock file.
#
# Scoping matters: the previous implementation used
#   pkill -9 -f 'nix develop .#test'
# which matches /proc/PID/cmdline of ANY process on the machine. On a
# host running several concurrent agent sessions that kills other
# people's shells mid-`dune`, leaving a stale _build/.lock behind —
# the exact §11.41 hang the kill was meant to prevent.
#
# Instead we kill only descendants of THIS shell. A dune started by
# this script is always our child; anything else is not ours to kill.
cleanup_dune_lock() {
  local pid child
  for pid in $(pgrep -P $$ 2>/dev/null || true); do
    for child in $(pgrep -P "$pid" 2>/dev/null || true); do
      case "$(tr '\0' ' ' < "/proc/$child/cmdline" 2>/dev/null || true)" in
        *dune*)
          kill -9 "$child" 2>/dev/null || true
          ;;
      esac
    done
  done
  [ ! -f _build/.lock ] || rm -f _build/.lock || true
}

case "$cmd" in
  build)
    cleanup_dune_lock
    run_in_shell "dune build --root . && echo 'build: ok'"
    ;;

  test)
    cleanup_dune_lock
    run_in_shell "dune test --root ."
    ;;

  rebuild)
    cleanup_dune_lock
    run_in_shell "dune clean && dune build --root . && echo 'rebuild: ok'"
    ;;

  lint)
    cleanup_dune_lock
    # Treat warnings as errors via dune's --error-on-warnings flag.
    # Exits nonzero if any test executable emits a warning.
    run_in_shell "dune build --root . --error-on-warnings && dune test --root . --error-on-warnings && echo 'lint: clean'"
    ;;

  verify)
    # Single entry point for "is this commit-ready?".
    # Order matters: build first (catches type errors), then dune
    # test (catches runtime regressions), then dune fmt --check
    # (catches formatting drift), then scripts/check.sh (catches
    # fixture regressions). Each step is independent so a fail in
    # step 3 doesn't skip step 4.
    cleanup_dune_lock
    # Each step is wrapped with an explicit 'echo STAGE: ...' so
    # CI logs identify the failing sub-step. Without this, a fail
    # in step 2 looks identical to a fail in step 4 (both return
    # exit 1 from `./scripts/dev verify`).
    echo "verify: stage 1/4 = dune build"
    run_in_shell "dune build --root . && echo 'verify build: ok'" || {
        echo "verify: FAIL at stage 1 (dune build)" >&2
        exit 1
    }
    echo "verify: stage 2/4 = dune test (with hang timeout)"
    run_in_shell "scripts/dune-test-with-timeout.sh && echo 'verify dune test: ok'" || {
        # dune-test-with-timeout.sh exits 124 on the documented
        # dune 3.23.1 deadlock; we treat that as a soft pass
        # because the underlying per-test `dune runtest` path
        # (run in scripts/check.sh) still proves the suite.
        if [ $? -eq 124 ]; then
            echo "verify: WARN at stage 2 (dune test hang at 600s; see decisions/disable-hanging-alcotest-tests-2026-10.yaml)"
        else
            echo "verify: FAIL at stage 2 (dune test)" >&2
            exit 1
        fi
    }
    # dune 3.23 has no --check flag; the fmt-check.sh wrapper
    # handles the "is tree clean?" check via dune fmt --preview.
    # See OCAML_BEST_PRACTICES §11.21.
    echo "verify: stage 3/4 = fmt-check.sh"
    ./scripts/fmt-check.sh && echo "verify fmt: ok" || {
        echo "verify: FAIL at stage 3 (fmt-check.sh)" >&2
        exit 1
    }
    echo "verify: stage 4/4 = check.sh"
    ./scripts/check.sh || {
        echo "verify: FAIL at stage 4 (check.sh)" >&2
        exit 1
    }
    echo "verify: ok"
    ;;

  check)
    nix flake check
    ;;

  close-branches)
    # Branch-hygiene per decisions/process-principles-close-branches.yaml.
    # List every local branch whose merge-base with `main` equals the
    # branch HEAD (i.e. fully merged into main). Refuses to consider
    # `main`, `HEAD`, or any `release/*` branch. With `--yes`, delete
    # each listed branch locally and push the deletion to origin; the
    # run is refused outright if any candidate has unpushed commits
    # (`git log @{u}..<branch>` non-empty).
    yes=0
    if [ "${1:-}" = "--yes" ]; then
      yes=1
      shift
    fi
    main_sha=$(git rev-parse --verify main)
    merged=()
    while IFS= read -r b; do
      case "$b" in
        main|HEAD) continue ;;
        release/*) continue ;;
      esac
      head_sha=$(git rev-parse --verify "$b" 2>/dev/null) || continue
      mb=$(git merge-base "$main_sha" "$head_sha" 2>/dev/null) || continue
      if [ "$mb" = "$head_sha" ]; then
        echo "$b"
        merged+=("$b")
      fi
    done < <(git for-each-ref --format='%(refname:short)' refs/heads/)

    if [ "$yes" = "1" ]; then
      # Refuse if any candidate has unpushed commits.
      for b in "${merged[@]}"; do
        [ -z "$b" ] && continue
        if git rev-parse --verify "$b@{u}" >/dev/null 2>&1; then
          if [ -n "$(git log "@{u}..$b" 2>/dev/null)" ]; then
            echo "close-branches: refuse — $b has unpushed commits" >&2
            exit 1
          fi
        fi
      done
      for b in "${merged[@]}"; do
        [ -z "$b" ] && continue
        git branch -d "$b"
        git push origin --delete "$b" \
          || echo "close-branches: push-failed for $b (no upstream?)" >&2
      done
    fi
    exit 0
    ;;

  init-hooks)
    # One-time per clone: point git at the in-repo .githooks/ dir.
    # After this, .githooks/pre-commit fires on every commit and
    # enforces process-principles P1 + P2 (see
    # decisions/process-principles-close-branches.yaml).
    git config core.hooksPath .githooks
    echo "init-hooks: core.hooksPath set to .githooks/"
    ;;

  lock-update)
    nix flake lock --update-input "$@"
    git diff flake.lock | head -50
    ;;

  shell)
    nix develop .#test --command bash
    ;;

  run)
    cleanup_dune_lock
    if [ $# -lt 1 ]; then usage; fi
    file="$1"
    run_in_shell "dune build --root . bin/mathc.exe && _build/default/bin/mathc.exe '$file'"
    ;;

  doctor)
    # Lightweight health check for the dev environment. Opt-in:
    # never runs as part of build/test/lint; a developer runs it
    # when something feels off. No nix-shell dependency — uses
    # `command -v` so it works in or out of the dev shell, and
    # plain file/grep counts that are fast on a tree this size.
    # Exits 0 if every check passes, 1 if any fails.
    cd "$(dirname "$0")/.."
    ok=0
    fail=0
    check() {
      local name="$1"
      local cmd="$2"
      if eval "$cmd" >/dev/null 2>&1; then
        printf "  \033[32m✓\033[0m %s\n" "$name"
        ok=$((ok + 1))
      else
        printf "  \033[31m✗\033[0m %s\n" "$name"
        fail=$((fail + 1))
      fi
    }
    echo "math-coding 3.3.1 — dev environment doctor"
    echo "=================================================="
    check "dune on PATH"          "command -v dune"
    check "ocamlmerlin on PATH"   "command -v ocamlmerlin"
    check "ocamllsp on PATH"      "command -v ocamllsp"
    check "ocamlformat on PATH"   "command -v ocamlformat"
    check "git on PATH"           "command -v git"
    check "nix on PATH"           "command -v nix"
    n_d=$(ls decisions/*.yaml 2>/dev/null | wc -l)
    n_a=$(ls attestations/*.json 2>/dev/null | wc -l)
    n_t=$(grep -cE '^### 11\.' OCAML_BEST_PRACTICES.md 2>/dev/null | head -1)
    echo ""
    echo "  decisions:    $n_d"
    echo "  attestations: $n_a"
    echo "  trap entries: $n_t"
    if [ "$n_d" -eq 0 ]; then
      printf "  \033[31m✗\033[0m at least one decision file present\n"; fail=$((fail + 1))
    else
      printf "  \033[32m✓\033[0m at least one decision file present\n"; ok=$((ok + 1))
    fi
    if [ "$n_a" -eq 0 ]; then
      printf "  \033[31m✗\033[0m at least one attestation present\n"; fail=$((fail + 1))
    else
      printf "  \033[32m✓\033[0m at least one attestation present\n"; ok=$((ok + 1))
    fi
    if [ "${n_t:-0}" -lt 25 ]; then
      printf "  \033[31m✗\033[0m trap log has 25+ entries (found %s)\n" "$n_t"; fail=$((fail + 1))
    else
      printf "  \033[32m✓\033[0m trap log has 25+ entries\n"; ok=$((ok + 1))
    fi
    echo ""
    printf "  %d passed, %d failed\n" "$ok" "$fail"
    [ "$fail" -eq 0 ]
    ;;

  precommit)
    # Guarantee .githooks/pre-commit is active, then exec git commit.
    # Idempotent: activates the hook if missing or pointing elsewhere,
    # then runs `git commit` with the caller's args verbatim. Required
    # because ad-hoc `git commit` on a fresh clone bypasses the
    # pre-commit verifier (see decisions/init-hooks-installer-2026-10).
    cd "$(dirname "$0")/.."
    if [ "$(git config core.hooksPath 2>/dev/null)" != ".githooks" ]; then
      echo "scripts/dev precommit: activating .githooks/ (was: $(git config core.hooksPath 2>/dev/null || echo '<unset>'))"
      git config core.hooksPath .githooks
    fi
    exec git commit "$@"
    ;;

  ready)
    # Definition-of-Done aggregator (AGENTS.md §Definition of Done).
    # Runs every check in deterministic order; halts on first
    # failure with the failing stage's exit code. Each stage
    # prints a header so CI logs identify the failing sub-step.
    cd "$(dirname "$0")/.."
    # Resolve the mathc binary at outer scope so the inner bash
    # passed to `nix develop --command bash -c "..."` inherits a
    # working path. Prefer the local build artifact; fall back
    # to a `mathc` symlink on PATH (~/.local/bin/mathc); bail
    # with a clear error if neither exists.
    if [ -x ./_build/default/bin/mathc.exe ]; then
      mathc_bin=./_build/default/bin/mathc.exe
    elif command -v mathc >/dev/null 2>&1; then
      mathc_bin=$(command -v mathc)
    else
      echo "scripts/dev ready: cannot find mathc binary (build with 'scripts/dev build' first, or install ~/.local/bin/mathc)" >&2
      exit 1
    fi
    MATHC_BIN="$mathc_bin" run_in_shell 'set -e; \
      echo "ready: stage 1/8 = scripts/dev verify"; \
      scripts/dev verify; \
      echo "ready: stage 2/8 = mathc validate (all decisions)"; \
      for d in decisions/*.yaml; do \
        case "$d" in \
          decisions/decision.yaml|decisions/obligations.yaml|decisions/rationale.md) ;; \
          *) "$MATHC_BIN" validate "$d" ;; \
        esac; \
      done; \
      echo "ready: stage 3/8 = mathc self-check"; \
      "$MATHC_BIN" self-check; \
      echo "ready: stage 4/8 = sync-version.sh --check"; \
      scripts/sync-version.sh --check; \
      echo "ready: stage 5/8 = check-merlin.sh"; \
      scripts/check-merlin.sh; \
      echo "ready: stage 6/8 = stub-lint (real-diff)"; \
      scripts/check-stub-lint.sh --mode=real-diff; \
      echo "ready: stage 7/8 = check-adoption-doc-freshen.sh"; \
      scripts/check-adoption-doc-freshen.sh; \
      echo "ready: stage 8/8 = check-opencode-skill.sh"; \
      scripts/check-opencode-skill.sh; \
      echo "ready: all checks passed"'
    ;;

  ""|-h|--help|help)
    usage
    ;;

  "edit-loop-detect")
    echo "edit-loop-detect: scanning last 5 commits for edit-loop pattern..."
    HOT=$(git log --name-only --pretty=format: -n 5 2>/dev/null \
      | grep -E '\.(ml|ocaml|decisions/.*\.yaml)$' \
      | sort | uniq -c | sort -rn | awk '$1 >= 3 {print $0}')
    if [ -n "$HOT" ]; then
      echo "POSSIBLE EDIT-LOOP: files modified 3+ times in last 5 commits:"
      echo "$HOT"
      echo ""
      echo "Recommended actions:"
      echo "  1. Write a probe executable: tests/probe_X.ml"
      echo "  2. Build with: dune build"
      echo "  3. Run: ./_build/default/tests/probe_X.exe"
      echo "  4. Identify SYNTAX (1-3 line fix) vs STRUCTURE (refactor)"
      echo ""
      echo "See AGENTS.md:Edit-loop prevention for the full rule."
      exit 1
    fi
    echo "edit-loop-detect: no edit-loop pattern detected"
    exit 0
    ;;

  test-fast)
    # Fast-path test runner (process-fastpath-2026-10). The
    # motivation is the dune 3.23.1 RPC hang in `dune test`
    # (OCAML_BEST_PRACTICES §11.34), which makes the full
    # stanza effectively unusable in this environment:
    # `dune test` typically hangs at a non-deterministic
    # point and the `dune-test-with-timeout.sh` wrapper kills
    # it after 600s. Per-binary `dune runtest tests/X.exe`
    # finishes in <1s when source is unchanged.
    #
    # Usage:
    #   scripts/dev test-fast              # run all 22 binaries
    #   scripts/dev test-fast X Y          # run only X.exe and Y.exe
    #   scripts/dev test-fast tests/X.exe  # full binary name accepted
    #
    # Implementation: `dune runtest` builds (if needed) and
    # executes the named test binary. We pass the test
    # binaries in their natural order from tests/dune.
    cleanup_dune_lock
    cd "$(dirname "$0")/.."
    if [ $# -eq 0 ]; then
      # Pull the test names from the (tests ...) stanza. The
      # list is intentionally duplicated here so the fast
      # runner can use it without re-parsing tests/dune; if
      # tests/dune changes, update this list.
      set -- \
        digest_vectors \
        conformance \
        repo_structure \
        process_principles \
        re_evaluation_test \
        render_kernel \
        risk_kernel \
        policy_test \
        ci_blocking_list_test \
        decision_parser_yaml \
        counters_drift \
        waiver_test \
        adopt_test \
        confidence_preserve \
        fixture_coverage \
        identity_uniqueness \
        traps \
        supersession_check \
        body_canonical_test \
        diagnostic_ux \
        yaml_block_scalars \
        path_config_test \
        qcheck_parsers
    fi
    fail=0
    ok=0
    for name in "$@"; do
      # Accept either "render_kernel" or "tests/render_kernel.exe".
      case "$name" in
        *.exe) target="$name" ;;
        tests/*) target="$name.exe" ;;
        *) target="tests/$name.exe" ;;
      esac
      printf 'test-fast: %s ... ' "$target"
      if run_in_shell "dune runtest --root . $target" >/dev/null 2>&1; then
        printf '\033[32mok\033[0m\n'
        ok=$((ok + 1))
      else
        printf '\033[31mFAIL\033[0m\n'
        fail=$((fail + 1))
      fi
    done
    echo "test-fast: $ok passed, $fail failed (of $#)"
    [ "$fail" -eq 0 ]
    ;;

  probe)
    # Parser probe (process-fastpath-2026-10). The fast path
    # for "I have a markdown input, I want to see the HTML
    # the kernel would produce" — designed for parser bug
    # fixes where a 5+ min full test cycle is wasteful.
    #
    # Usage:
    #   scripts/dev probe '1. first\n2. second'    # argument
    #   scripts/dev probe --file site/foo.md        # from file
    #   echo '1. foo' | scripts/dev probe           # from stdin
    #
    # Implementation: builds bin/md_probe.exe on demand
    # (a small driver that reads stdin or a file and calls
    # Render.md_parse) and runs it under the nix shell.
    cleanup_dune_lock
    cd "$(dirname "$0")/.."
    if [ ! -f bin/md_probe.ml ]; then
      echo "probe: bin/md_probe.ml not found; nothing to build" >&2
      exit 1
    fi
    if [ "${1:-}" = "--file" ]; then
      if [ $# -lt 2 ]; then
        echo "probe: --file requires a path argument" >&2
        exit 1
      fi
      run_in_shell "dune build --root . bin/md_probe.exe && _build/default/bin/md_probe.exe --file '$2'"
    elif [ $# -ge 1 ]; then
      # Argument: pass via stdin (printf is shell-safe for
      # markdown which never contains NUL bytes; embedded
      # newlines are preserved because the outer wrapping
      # is single-quoted only after escape).
      arg="$1"
      # Use a here-string: bash-only but the file already
      # has `set -eu` from the parent. We delegate to
      # nix develop with a heredoc to preserve the literal.
      run_in_shell "dune build --root . bin/md_probe.exe && _build/default/bin/md_probe.exe <<'PROBE_EOF'
$arg
PROBE_EOF"
    else
      # No argument: read from stdin
      run_in_shell "dune build --root . bin/md_probe.exe && _build/default/bin/md_probe.exe"
    fi
    ;;
  *)
    echo "unknown subcommand: $cmd" >&2
    usage
    ;;
esac
