#!/usr/bin/env bash
# math-coding 3.0-alpha — repeatable development commands.
#
# Each subcommand prints what it is doing. None of them are silent.
# Use these instead of "rm -rf _build" superstition.
#
# Usage:
#   scripts/dev build                — compile kernel + CLI
#   scripts/dev test                 — run conformance suite
#   scripts/dev rebuild              — full rebuild (when build is wedged)
#   scripts/dev lint                 — strict warnings-as-errors build
#   scripts/dev verify               — full check before commit: build +
#                                     dune test + scripts/check.sh + fmt
#   scripts/dev check                — nix flake check
#   scripts/dev close-branches       — list branches merged into main
#                                     [--yes] also delete + push to origin
#   scripts/dev init-hooks           — one-time: git config core.hooksPath
#                                     .githooks
#   scripts/dev lock-update          — refresh flake.lock
#   scripts/dev shell                — drop into nix develop .#test
#   scripts/dev run FILE             — build + run mathc.exe FILE

set -eu
cd "$(dirname "$0")/.."

usage() {
  sed -n '2,21p' "$0"
  exit 1
}

cmd="${1:-}"
shift || true

run_in_shell() {
  nix develop .#test --command bash -c "$1"
}

# Kill any stale dune / nix-develop processes that may hold
# _build/.lock from a previous interrupted run. Idempotent.
cleanup_dune_lock() {
  pkill -9 -f 'dune build'  2>/dev/null || true
  pkill -9 -f 'dune test'   2>/dev/null || true
  pkill -9 -f 'nix develop .#test' 2>/dev/null || true
  [ ! -f _build/.lock ] || rm -f _build/.lock || true
  sleep 1
}

case "$cmd" in
  build)
    cleanup_dune_lock
    run_in_shell "dune build --root . && echo 'build: ok'"
    ;;

  test)
    cleanup_dune_lock
    run_in_shell "dune test --root ."
    ;;

  rebuild)
    cleanup_dune_lock
    run_in_shell "dune clean && dune build --root . && echo 'rebuild: ok'"
    ;;

  lint)
    cleanup_dune_lock
    # Treat warnings as errors via dune's --error-on-warnings flag.
    # Exits nonzero if any test executable emits a warning.
    run_in_shell "dune build --root . --error-on-warnings && dune test --root . --error-on-warnings && echo 'lint: clean'"
    ;;

  verify)
    # Single entry point for "is this commit-ready?".
    # Order matters: build first (catches type errors), then dune
    # test (catches runtime regressions), then dune fmt --check
    # (catches formatting drift), then scripts/check.sh (catches
    # fixture regressions). Each step is independent so a fail in
    # step 3 doesn't skip step 4.
    cleanup_dune_lock
    # Each step is wrapped with an explicit 'echo STAGE: ...' so
    # CI logs identify the failing sub-step. Without this, a fail
    # in step 2 looks identical to a fail in step 4 (both return
    # exit 1 from `./scripts/dev verify`).
    echo "verify: stage 1/4 = dune build"
    run_in_shell "dune build --root . && echo 'verify build: ok'" || {
        echo "verify: FAIL at stage 1 (dune build)" >&2
        exit 1
    }
    echo "verify: stage 2/4 = dune test"
    run_in_shell "dune test --root . && echo 'verify dune test: ok'" || {
        echo "verify: FAIL at stage 2 (dune test)" >&2
        exit 1
    }
    # dune 3.23 has no --check flag; the fmt-check.sh wrapper
    # handles the "is tree clean?" check via dune fmt --preview.
    # See OCAML_BEST_PRACTICES §11.21.
    echo "verify: stage 3/4 = fmt-check.sh"
    ./scripts/fmt-check.sh && echo "verify fmt: ok" || {
        echo "verify: FAIL at stage 3 (fmt-check.sh)" >&2
        exit 1
    }
    echo "verify: stage 4/4 = check.sh"
    ./scripts/check.sh || {
        echo "verify: FAIL at stage 4 (check.sh)" >&2
        exit 1
    }
    echo "verify: ok"
    ;;

  check)
    nix flake check
    ;;

  close-branches)
    # Branch-hygiene per decisions/process-principles-close-branches.yaml.
    # List every local branch whose merge-base with `main` equals the
    # branch HEAD (i.e. fully merged into main). Refuses to consider
    # `main`, `HEAD`, or any `release/*` branch. With `--yes`, delete
    # each listed branch locally and push the deletion to origin; the
    # run is refused outright if any candidate has unpushed commits
    # (`git log @{u}..<branch>` non-empty).
    yes=0
    if [ "${1:-}" = "--yes" ]; then
      yes=1
      shift
    fi
    main_sha=$(git rev-parse --verify main)
    merged=()
    while IFS= read -r b; do
      case "$b" in
        main|HEAD) continue ;;
        release/*) continue ;;
      esac
      head_sha=$(git rev-parse --verify "$b" 2>/dev/null) || continue
      mb=$(git merge-base "$main_sha" "$head_sha" 2>/dev/null) || continue
      if [ "$mb" = "$head_sha" ]; then
        echo "$b"
        merged+=("$b")
      fi
    done < <(git for-each-ref --format='%(refname:short)' refs/heads/)

    if [ "$yes" = "1" ]; then
      # Refuse if any candidate has unpushed commits.
      for b in "${merged[@]}"; do
        [ -z "$b" ] && continue
        if git rev-parse --verify "$b@{u}" >/dev/null 2>&1; then
          if [ -n "$(git log "@{u}..$b" 2>/dev/null)" ]; then
            echo "close-branches: refuse — $b has unpushed commits" >&2
            exit 1
          fi
        fi
      done
      for b in "${merged[@]}"; do
        [ -z "$b" ] && continue
        git branch -d "$b"
        git push origin --delete "$b" \
          || echo "close-branches: push-failed for $b (no upstream?)" >&2
      done
    fi
    exit 0
    ;;

  init-hooks)
    # One-time per clone: point git at the in-repo .githooks/ dir.
    # After this, .githooks/pre-commit fires on every commit and
    # enforces process-principles P1 + P2 (see
    # decisions/process-principles-close-branches.yaml).
    git config core.hooksPath .githooks
    echo "init-hooks: core.hooksPath set to .githooks/"
    ;;

  lock-update)
    nix flake lock --update-input "$@"
    git diff flake.lock | head -50
    ;;

  shell)
    nix develop .#test --command bash
    ;;

  run)
    cleanup_dune_lock
    if [ $# -lt 1 ]; then usage; fi
    file="$1"
    run_in_shell "dune build --root . bin/mathc.exe && _build/default/bin/mathc.exe '$file'"
    ;;

  ""|-h|--help|help)
    usage
    ;;

  *)
    echo "unknown subcommand: $cmd" >&2
    usage
    ;;
esac
