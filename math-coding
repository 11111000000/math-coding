#!/bin/sh
# math-coding — math-coding v0.993 dispatcher.
#
# Single entry point. Resolves REPO_ROOT via core/lib/common.sh,
# then routes commands to the right tool.

set -u

. "$(dirname "$0")/core/lib/common.sh"

usage() {
    cat <<EOF
usage: math-coding <command> [args...]

Commands:
  create <name> --from <spec.yaml>
                   Create a packet from a YAML spec (file or '-'). 7 fields:
                   proposition, outcome, invariant, test, antithesis, synthesis,
                   operation. v0.993: only proposition + outcome are mandatory.
  apply <name>    Record SHA witness and transition to applied.
  review <name>   Peer-review: --approve | --request-changes | --comment.
                   v0.993: applied needs >=1 approve.
  lifecycle <name> <state> [--reason=<text>] [--supersede-with=<name>]
                   Transition: applied | retired | abandoned. Aliases
                   to apply/retire/abandon.
  verify [--cross-packet-consistency]
                   Run core/check/verify.sh on all packets.
  drift-check     Run core/check/drift-check.sh on witness files.
  probe           Run core/self/probe.sh (axiom A6 self-application).
  install <path>  Install convention (default: shared at \$XDG_DATA_HOME).
  install --local <path>
                   Legacy in-repo install (hermetic CI).
  upgrade         Refresh shared install from current source-repo.
  uninstall <path>
                   Remove project wrapper and (with --local) .math-coding/.
  install-skill [opts]
                   Install skill/agent/hook payloads.
  help            This message.

Examples:
  sh math-coding create my-feature --from spec.yaml
  sh math-coding apply my-feature
  sh math-coding verify
  sh math-coding probe
  sh math-coding install /path/to/project
EOF
}

case "${1:-help}" in
    create)
        shift
        exec sh "$REPO_ROOT/core/author/create-packet.sh" "$@"
        ;;
    apply|review|retire|abandon|stable|archive|amend)
        cmd="$1"
        shift
        exec sh "$REPO_ROOT/core/author/lifecycle.sh" "$cmd" "$@"
        ;;
    lifecycle)
        shift
        # Legacy form: lifecycle <name> <state>. Detect by second
        # arg being a known state.
        if [ $# -ge 2 ] && case "$2" in
            applied|retired|abandoned|draft) true ;;
            *) false ;;
        esac; then
            state="$2"
            name="$1"
            shift 2
            case "$state" in
                applied)   exec sh "$REPO_ROOT/core/author/lifecycle.sh" apply "$name" "$@" ;;
                retired)   exec sh "$REPO_ROOT/core/author/lifecycle.sh" retire "$name" "$@" ;;
                abandoned) exec sh "$REPO_ROOT/core/author/lifecycle.sh" abandon "$name" "$@" ;;
                draft)     echo "error: cannot transition to 'draft'" >&2; exit 1 ;;
            esac
        fi
        exec sh "$REPO_ROOT/core/author/lifecycle.sh" "$@"
        ;;
    verify)
        shift
        exec sh "$REPO_ROOT/core/check/verify.sh" "$@"
        ;;
    drift-check)
        exec sh "$REPO_ROOT/core/check/drift-check.sh"
        ;;
    probe)
        exec sh "$REPO_ROOT/core/self/probe.sh"
        ;;
    install)
        shift
        exec sh "$REPO_ROOT/core/install/install.sh" "$@"
        ;;
    install-skill)
        shift
        exec sh "$REPO_ROOT/core/install/install-skill.sh" "$@"
        ;;
    upgrade)
        exec sh "$REPO_ROOT/core/install/upgrade.sh"
        ;;
    uninstall)
        shift
        exec sh "$REPO_ROOT/core/install/uninstall.sh" "$@"
        ;;
    help|--help|-h|"")
        usage
        ;;
    *)
        echo "math-coding: unknown command '$1'" >&2
        usage >&2
        exit 2
        ;;
esac
