#!/bin/sh
# math-coding wrapper — resolves to shared install.
#
# Created by scripts/install.sh when the user runs `nix develop` or
# `sh scripts/install.sh`. Lives at the project root and forwards to
# the OCaml binary in $XDG_DATA_HOME/math-coding/current/math-coding.
#
# Safe to commit: it contains no project state; it is regenerated by
# the install script if missing.

set -u

DATA="${XDG_DATA_HOME:-$HOME/.local/share}"
TARGET=""

for d in \
  "$DATA/math-coding/current" \
  "/usr/local/share/math-coding/current" \
  "/opt/math-coding/current"; do
  if [ -x "$d/math-coding" ]; then
    TARGET="$d/math-coding"
    break
  fi
done

# Legacy in-repo layout (kept for v0.993-era installations).
if [ -z "$TARGET" ] && [ -x "./.math-coding/math-coding" ]; then
  TARGET="./.math-coding/math-coding"
fi

if [ -z "$TARGET" ]; then
  echo "math-coding: no install found. Run one of:" >&2
  echo "    nix develop --command bash -c 'sh scripts/install.sh'" >&2
  echo "    sh scripts/install.sh" >&2
  exit 127
fi

exec "$TARGET" "$@"
